# Copy to backend/.env and adjust.
DATABASE_URL=postgresql+psycopg://agriflow:agriflow@localhost:5432/agriflow
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# --- V2 external data ---------------------------------------------------
# Free key from https://data.gov.in (sign in -> My Account -> API key).
# Without it the AGMARKNET mandi price source shows "Not configured".
DATA_GOV_IN_API_KEY=
# States to fetch mandi prices for (JSON list).
MANDI_STATES=["Karnataka"]

# --- V3 automatic refresh (python -m app.scheduler) ----------------------
# Weather: Open-Meteo updates current conditions every 15 min; hourly polling is plenty.
WEATHER_REFRESH_MINUTES=60
# Mandi prices: data.gov.in fills in through the day as mandis report. Fetch at these IST times.
MARKET_FETCH_TIMES_IST=["10:30","14:30","19:30"]
# After a failed fetch, retry after this many minutes (never in a tight loop).
RETRY_AFTER_FAILURE_MINUTES=20
# HTTP: one retry with backoff on timeouts / network errors / 5xx.
HTTP_RETRIES=1
HTTP_BACKOFF_SECONDS=2
