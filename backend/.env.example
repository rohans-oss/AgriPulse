# Copy to backend/.env and adjust.
DATABASE_URL=postgresql+psycopg://agriflow:agriflow@localhost:5432/agriflow
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# --- V2 external data ---------------------------------------------------
# Free key from https://data.gov.in (sign in -> My Account -> API key).
# Without it the AGMARKNET mandi price source shows "Not configured".
DATA_GOV_IN_API_KEY=
# States to fetch mandi prices for (JSON list).
MANDI_STATES=["Karnataka"]
